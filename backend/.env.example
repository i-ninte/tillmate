# TillMate Backend Configuration

# Database (async for FastAPI)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tillmate

# Database (sync for Alembic migrations)
DATABASE_URL_SYNC=mysql+pymysql://user:password@localhost:3306/tillmate

# API Settings
API_PREFIX=/api/v1
DEBUG=true

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=["*"]
